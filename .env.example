# ===========================================
# EP-133 Directory - Environment Variables
# ===========================================

# Payload CMS Configuration
# -------------------------
# URL where Payload CMS is running (used by Astro to fetch data)
PAYLOAD_URL=http://localhost:3001

# Secret key for Payload CMS (generate a random string)
PAYLOAD_SECRET=your-super-secret-key-change-this

# Database Configuration
# ----------------------
# MongoDB connection string (default for local development)
DATABASE_URI=mongodb://localhost:27017/ep133-directory

# Or use PostgreSQL (uncomment and configure if preferred)
# DATABASE_URI=postgresql://user:password@localhost:5432/ep133_directory

# Public Site Configuration
# -------------------------
# The public URL of your Astro site (for SEO, canonical URLs, etc.)
PUBLIC_SITE_URL=http://localhost:4321

# Optional: Admin user for seeding
# --------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
