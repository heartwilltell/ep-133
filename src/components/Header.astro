---
import ThemeToggle from './ThemeToggle';
import SearchTrigger from './SearchTrigger';

const navLinks = [
  { href: '/listings', label: 'Directory' },
  { href: '/categories', label: 'Categories' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--background)]/95 backdrop-blur-sm">
  <div class="container mx-auto px-4">
    <nav class="flex items-center justify-between h-14">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 text-lg font-bold tracking-tight hover:opacity-80 transition-opacity"
      >
        <span class="inline-flex items-center justify-center w-8 h-8 bg-[var(--accent)] text-white rounded text-xs font-mono font-bold">
          EP
        </span>
        <span class="hidden sm:inline">133 Directory</span>
      </a>

      <!-- Navigation Links -->
      <div class="flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-1.5 text-sm font-medium rounded transition-colors',
              currentPath.startsWith(link.href)
                ? 'bg-[var(--control-active)] text-[var(--foreground)]'
                : 'text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:bg-[var(--control)]'
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <SearchTrigger client:load />
        <ThemeToggle client:load />
      </div>
    </nav>
  </div>
</header>
